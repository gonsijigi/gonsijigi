# 수업에서 안내받은 vLLM 엔드포인트 값을 .env 파일에 복사해 사용하세요.
# .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다. (API 키 커밋 금지!)
LLM_BASE_URL=http://<수업용-vLLM-주소>/v1/
LLM_API_KEY=<수업용-API-KEY>
LLM_MODEL=gemma-4-e4b-it
# D1 이후: DART_API_KEY=<opendart 발급 키>

# D2: PostgreSQL + pgvector (infra/docker-compose.yml의 db 서비스 기준)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gonsijigi
POSTGRES_USER=gonsijigi
POSTGRES_PASSWORD=devpass
